{
  "id": "./",
  "name": "Dayline — Tasks, Goals & Daily Progress",
  "short_name": "Dayline",
  "description": "A calm personal workspace to capture tasks, plan events, track goals, record progress, and make room for what matters.",
  "lang": "en",
  "start_url": "./index.html?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
